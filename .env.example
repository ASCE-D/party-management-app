# AWS Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit real credentials to version control

# AWS Region
VITE_AWS_REGION=us-east-1

# AWS Credentials (use IAM user with SNS permissions)
VITE_AWS_ACCESS_KEY_ID=your_access_key_id
VITE_AWS_SECRET_ACCESS_KEY=your_secret_access_key

# SNS Platform Application ARN for mobile push
# Get this from AWS SNS Console > Platform applications
VITE_SNS_PLATFORM_APPLICATION_ARN=arn:aws:sns:us-east-1:123456789:app/GCM/your-app-name

# Firebase Configuration (for FCM)
# These are already in google-services.json, but you can add them here for web
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
