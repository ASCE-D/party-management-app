# Firebase Web SDK (client)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key (Firebase console -> Project Settings -> Cloud Messaging -> Web configuration)
VITE_FIREBASE_VAPID_KEY=

# Endpoint to register device token.
# If using the provided Cloud Function, you can expose an HTTP endpoint for registration.
# (This repo includes a callable function; for simplicity this example uses HTTP.)
VITE_REGISTER_DEVICE_TOKEN_ENDPOINT=